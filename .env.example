CLOUDTAK_Mode=docker-compose
CLOUDTAK_Config_media_url=http://media
CLOUDTAK_Config_media_internal_url=http://media:9997
CLOUDTAK_Config_media_public_url=http://localhost:8888

SigningSecret=coe-wildland-fire

ASSET_BUCKET=cloudtak
AWS_S3_Endpoint=http://store:3900
AWS_S3_AccessKeyId=cloudtakstoreadmin
AWS_S3_SecretAccessKey=cloudtakstoreadmin
# Generated automatically by ./cloudtak.sh
GARAGE_RPC_SECRET=

POSTGRES=postgres://docker:docker@postgis:5432/gis
# Initialize with `./cloudtak.sh database-volume` before direct Docker Compose use.
POSTGIS_VOLUME_NAME=cloudtak-postgis-data

API_URL=http://localhost:5000
PMTILES_URL=http://tiles:5002
